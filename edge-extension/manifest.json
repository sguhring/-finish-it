{
  "manifest_version": 3,
  "name": "Finish IT bridge",
  "version": "2.0",
  "description": "Reads the live Scolia scores out of the page and pushes them to the local Finish IT app (no OCR). Also injects OCR-A as a fallback.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5000/*", "http://localhost:5000/*", "https://game.scoliadarts.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
